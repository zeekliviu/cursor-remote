{
  "expo": {
    "name": "Cursor Remote",
    "slug": "cursor-remote",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cursor-remote",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f4ee",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR from the daemon host.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos from your library to Cursor Composer messages.",
          "cameraPermission": "Optionally capture photos to send to Cursor."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2f5d3a"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cursorremote.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your Cursor Remote daemon on the local network or VPN.",
        "NSPhotoLibraryUsageDescription": "Attach photos to Cursor Composer messages.",
        "NSCameraUsageDescription": "Optionally capture photos to send to Cursor.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "label": "Cursor Remote",
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.cursorremote.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f7f4ee"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "privacyPolicyUrl": "https://github.com/zeekliviu/cursor-remote/blob/main/docs/privacy.md",
      "router": {},
      "eas": {
        "projectId": "d3b29486-57c5-4990-b7e9-d7f7a34b9175"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "owner": "zeekliviu"
  }
}
